<Window x:Class="SportNutritionShop.Views.DatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление базой данных"
        Width="1280" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/App.ico"
        Cursor="/Assets/Cursors/shop.cur"
        ForceCursor="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Управление базой данных" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="{Binding DatabasePath}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Закрыть" MinWidth="110" Click="Close_Click"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,14">
            <WrapPanel>
                <Button Content="Товары" Margin="0,0,8,8" Command="{Binding SelectTableCommand}" CommandParameter="Products"/>
                <Button Content="Категории" Margin="0,0,8,8" Command="{Binding SelectTableCommand}" CommandParameter="Categories"/>
                <Button Content="Пользователи" Margin="0,0,8,8" Command="{Binding SelectTableCommand}" CommandParameter="Users"/>
                <Button Content="Заказы" Margin="0,0,8,8" Command="{Binding SelectTableCommand}" CommandParameter="Orders"/>
                <Button Content="Состав заказов" Margin="0,0,8,8" Command="{Binding SelectTableCommand}" CommandParameter="OrderItems"/>
                <Button Content="Журнал" Margin="0,0,8,8" Command="{Binding SelectTableCommand}" CommandParameter="AuditLog"/>
                <Button Content="Именованные команды" Margin="0,0,8,8" Command="{Binding SelectTableCommand}" CommandParameter="StoredCommands"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button Content="Обновить" Margin="0,0,8,8" Command="{Binding RefreshCommand}"/>
                    <Button Content="Добавить строку" Margin="0,0,8,8" Command="{Binding AddRowCommand}"/>
                    <Button Content="Удалить строку" Margin="0,0,8,8" Background="{DynamicResource DangerBrush}" Command="{Binding DeleteRowCommand}"/>
                    <Button Content="Сохранить транзакцию" Margin="0,0,8,8" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}"/>
                    <Button Content="Сортировать ↑" Margin="0,0,8,8" Command="{Binding SortAscendingCommand}"/>
                    <Button Content="Сортировать ↓" Margin="0,0,8,8" Command="{Binding SortDescendingCommand}"/>
                    <Button Content="Малый остаток" Margin="0,0,8,8" Command="{Binding LowStockCommand}"/>
                    <Button Content="sp_ProductStatistics" Margin="0,0,8,8" Command="{Binding StoredCommand}"/>
                </WrapPanel>

                <DataGrid x:Name="DatabaseGrid"
                          ItemsSource="{Binding CurrentView}"
                          SelectedItem="{Binding SelectedRow}"
                          AutoGenerateColumns="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="All"
                          GridLinesVisibility="All"
                          AlternatingRowBackground="#F1F5F9"
                          RowBackground="White"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          AutoGeneratingColumn="DatabaseGrid_AutoGeneratingColumn">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="IsReadOnly" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanEdit}" Value="True">
                                    <Setter Property="IsReadOnly" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock Grid.Column="1" Text="ADO.NET • SQLite • Data Binding" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
        </Grid>
    </Grid>
</Window>
