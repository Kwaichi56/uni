<Window x:Class="SportNutritionShop.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProfileTitle}"
        Width="480"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Cursor="/Assets/Cursors/shop.cur"
        ForceCursor="True"
        Icon="/Assets/App.ico">
    <Grid Margin="24">
        <Border Style="{StaticResource CardBorderStyle}" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ProfileTitle}" Style="{StaticResource PageTitleTextStyle}" Margin="0,0,0,16"/>

                    <TextBlock Text="{DynamicResource FirstNameLabel}" Margin="0,0,0,6"/>
                    <TextBox x:Name="FirstNameTextBox" Height="38" Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource LastNameLabel}" Margin="0,0,0,6"/>
                    <TextBox x:Name="LastNameTextBox" Height="38" Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource EmailLabel}" Margin="0,0,0,6"/>
                    <TextBox x:Name="EmailTextBox" Height="38" Margin="0,0,0,12"/>

                    <TextBlock Text="{DynamicResource PhoneLabel}" Margin="0,0,0,6"/>
                    <TextBox x:Name="PhoneTextBox" Height="38" Margin="0,0,0,18"/>

                    <TextBlock Text="{DynamicResource LanguageLabel}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <RadioButton x:Name="LanguageRuRadio" Content="RU" GroupName="Language" Style="{StaticResource ChipRadioButtonStyle}" Checked="LanguageRu_Checked"/>
                        <RadioButton x:Name="LanguageEnRadio" Content="EN" GroupName="Language" Style="{StaticResource ChipRadioButtonStyle}" Checked="LanguageEn_Checked"/>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource ThemeLabel}" Margin="0,0,0,6"/>
                    <WrapPanel Margin="0,0,0,18">
                        <RadioButton x:Name="ThemeClassicRadio" Content="{DynamicResource ThemeClassic}" GroupName="Theme" Style="{StaticResource ChipRadioButtonStyle}" Checked="ThemeClassic_Checked"/>
                        <RadioButton x:Name="ThemeOptimisticRadio" Content="{DynamicResource ThemeOptimistic}" GroupName="Theme" Style="{StaticResource ChipRadioButtonStyle}" Checked="ThemeOptimistic_Checked"/>
                        <RadioButton x:Name="ThemePinkRadio" Content="{DynamicResource ThemePink}" GroupName="Theme" Style="{StaticResource ChipRadioButtonStyle}" Checked="ThemePink_Checked"/>
                        <RadioButton x:Name="ThemeGrayscaleRadio" Content="{DynamicResource ThemeGrayscale}" GroupName="Theme" Style="{StaticResource ChipRadioButtonStyle}" Checked="ThemeGrayscale_Checked"/>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource CloseButton}" MinWidth="100" Margin="0,0,8,0" Click="Close_Click"/>
                        <Button Content="{DynamicResource SaveButton}" MinWidth="120" Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
