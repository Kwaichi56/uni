<UserControl x:Class="SportNutritionShop.UserControls.PriceRangeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="80">
    <StackPanel>
        <TextBlock Margin="0,0,0,6">
            <Run Text="Цена: "/>
            <Run Text="{Binding MinPrice, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Run Text=" — "/>
            <Run Text="{Binding MaxPrice, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Run Text=" BYN"/>
        </TextBlock>
        <Slider x:Name="MinSlider" Minimum="0" Maximum="200" TickFrequency="10"
                IsSnapToTickEnabled="True" ValueChanged="MinSlider_ValueChanged" Margin="0,0,0,4"/>
        <Slider x:Name="MaxSlider" Minimum="0" Maximum="200" TickFrequency="10"
                IsSnapToTickEnabled="True" ValueChanged="MaxSlider_ValueChanged"/>
    </StackPanel>
</UserControl>
