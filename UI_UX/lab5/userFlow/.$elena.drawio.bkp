        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Настройки цветов\n    classDef st fill:#000000,stroke:#000000,color:#ffffff\n    classDef screen fill:#B39DDB,stroke:#7E57C2,color:#000000,rx:8,ry:8\n    classDef cond fill:#E1BEE7,stroke:#9C27B0,color:#000000\n    classDef sys fill:#F5F5F5,stroke:#BDBDBD,color:#000000\n    classDef default fill:#ffffff,stroke:#000000,color:#000000\n\n    Start([Начало]):::st --&gt; S1[Главный экран]:::screen\n    S1 --&gt; A1[Нажатие &#39;В конструктор&#39;]\n    A1 --&gt; S2[Экран конструктора тарифа]:::screen\n    \n    S2 --&gt; A2[Ползунок ГБ на &#39;Безлимит&#39;]\n    A2 --&gt; A3[Ползунок минут на &#39;0&#39;]\n    A3 --&gt; A4[Галочка &#39;Безлимит на соцсети&#39;]\n    \n    A4 --&gt; Sys1[/Система: Пересчет стоимости/]:::sys\n    Sys1 --&gt; A5[Нажатие &#39;Применить тариф&#39;]\n    \n    A5 --&gt; Cond1{Достаточно средств на балансе?}:::cond\n\n    Cond1 -- Нет --&gt; S3[Экран пополнения баланса]:::screen\n    S3 --&gt; A6[Ввод суммы и оплата]\n    A6 --&gt; Cond2{Оплата успешна?}:::cond\n    Cond2 -- Нет --&gt; S3\n    Cond2 -- Да --&gt; Sys2\n\n    Cond1 -- Да --&gt; Sys2[/Система: Списание средств/]:::sys\n    Sys2 --&gt; S4[Экран: Тариф успешно обновлен]:::screen\n    S4 --&gt; A7[Нажатие &#39;На главную&#39;]\n    A7 --&gt; S5[Обновленный Главный экран с безлимитом]:::screen\n    S5 --&gt; End([Конец]):::st&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4Ubc3d0kNBlyQZsGm3x4-140">
