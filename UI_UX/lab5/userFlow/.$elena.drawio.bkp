        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Настройки цветов\n    classDef st fill:#000000,stroke:#000000,color:#ffffff\n    classDef screen fill:#B39DDB,stroke:#7E57C2,color:#000000,rx:8,ry:8\n    classDef cond fill:#E1BEE7,stroke:#9C27B0,color:#000000\n    classDef sys fill:#F5F5F5,stroke:#BDBDBD,color:#000000\n\n    Start([Начало: Запуск приложения]):::st --&gt; S1[Главный экран]:::screen\n    S1 --&gt; A1[Нажатие на раздел &#39;Услуги и подписки&#39;]\n    A1 --&gt; S2[Экран: Мои подключенные услуги]:::screen\n    \n    S2 --&gt; Sys1[/Система: Загрузка списка активных услуг/]:::sys\n    Sys1 --&gt; Cond1{Список загружен?}:::cond\n    \n    Cond1 -- Нет, ошибка сети --&gt; S3[Экран: Ошибка соединения]:::screen\n    S3 --&gt; A2[Нажатие &#39;Повторить&#39;] --&gt; Sys1\n    \n    Cond1 -- Да --&gt; S4[Экран: Список услуг с тумблерами]:::screen\n    S4 --&gt; A3[Скролл и просмотр платных подписок]\n    A3 --&gt; Cond2{Есть ли лишние платные подписки?}:::cond\n    \n    Cond2 -- Да --&gt; A4[Нажатие на тумблер &#39;Выкл&#39; напротив услуги]\n    A4 --&gt; Sys2[/Система: Деактивация подписки в биллинге/]:::sys\n    Sys2 --&gt; S5[Экран: Услуга успешно отключена]:::screen\n    S5 --&gt; A5[Нажатие &#39;Вернуться к списку&#39;]\n    A5 --&gt; S4\n    \n    Cond2 -- Нет, всё корректно --&gt; End([Конец: Причина списаний выяснена]):::st&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4Ubc3d0kNBlyQZsGm3x4-201">
