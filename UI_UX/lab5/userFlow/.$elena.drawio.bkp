        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Настройки цветов\n    classDef st fill:#000000,stroke:#000000,color:#ffffff\n    classDef screen fill:#B39DDB,stroke:#7E57C2,color:#000000,rx:8,ry:8\n    classDef cond fill:#E1BEE7,stroke:#9C27B0,color:#000000\n    classDef sys fill:#F5F5F5,stroke:#BDBDBD,color:#000000\n    classDef default fill:#ffffff,stroke:#000000,color:#000000\n\n    Start([Начало: Нужен второй номер]):::st --&gt; S1[Экран: Каталог тарифов]:::screen\n    S1 --&gt; A1[Выбор тарифа и нажатие &#39;Оформить eSIM&#39;]\n    A1 --&gt; Sys1[/Система: Проверка устройства на поддержку eSIM/]:::sys\n    Sys1 --&gt; Cond1{Устройство поддерживает?}:::cond\n    \n    Cond1 -- Нет --&gt; S2[Экран: Заказ пластиковой SIM]:::screen\n    S2 --&gt; End1([Конец: Сценарий прерван]):::st\n    \n    Cond1 -- Да --&gt; S3[Экран: Способ идентификации]:::screen\n    S3 --&gt; A2[Выбор &#39;Через Банк ID&#39;]\n    A2 --&gt; Sys2[/Система: Интеграция с банковским API/]:::sys\n    Sys2 --&gt; Cond2{Идентификация успешна?}:::cond\n    \n    Cond2 -- Нет --&gt; S4[Экран: Ошибка данных]:::screen\n    S4 --&gt; A3[Нажатие &#39;Ввести вручную&#39;] --&gt; Sys2\n    \n    Cond2 -- Да --&gt; S5[Экран: Оформление завершено]:::screen\n    S5 --&gt; A4[Нажатие &#39;Установить eSIM&#39;]\n    A4 --&gt; Sys3[/Система: Загрузка профиля в телефон/]:::sys\n    Sys3 --&gt; S6[Главный экран: Появился второй номер]:::screen\n    S6 --&gt; End2([Конец: eSIM активирована]):::st&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4Ubc3d0kNBlyQZsGm3x4-139">
